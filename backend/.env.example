# GitHub personal access token (classic with `repo` + `read:org`,
# or fine-grained with PR read across the orgs/repos you care about).
GITHUB_TOKEN=

# How often the poller hits the GitHub GraphQL API, in seconds.
# At 300s (5 min) we issue ~12 combined queries/hour. Each query
# can cost ~100-200 GraphQL points with our nested fragments, so this
# stays comfortably under the 5,000 points/hour primary limit and well
# clear of GitHub's secondary anti-burst limit. Lower with care.
POLL_INTERVAL_SECONDS=300

# Comma-separated list of bot logins. Comments / review threads opened
# by these accounts count toward the "B" chip; everyone else is a human.
BOT_LOGINS=cursor,cursor[bot],coderabbitai,coderabbitai[bot]

# Marker prefix used to detect the deployment-status comment on a PR.
PREVIEW_COMMENT_PREFIX=Preview Environment URL:

# GraphQL endpoint. Override for GitHub Enterprise.
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# REST API root. Override for GitHub Enterprise.
GITHUB_API_URL=https://api.github.com

# Maximum number of open PRs fetched per poll.
MAX_PRS=50

# GitHub login to track on each PR card as the "review requested from"
# reviewer. The card shows a blue R chip when this user is on the PR's
# requested-reviewers list, otherwise a one-click "request review" button.
# Set to an empty string to disable the feature.
REVIEWER_LOGIN=nicoraga1

# Merge method used by the per-card MERGE button when REVIEWER_LOGIN
# has approved the PR. One of: merge, squash, rebase.
MERGE_METHOD=merge
