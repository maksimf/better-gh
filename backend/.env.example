# --- GitHub OAuth App ---
# Anyone with a GitHub account signs in via the OAuth Web Application
# Flow; there's no shared PAT anymore. Register an OAuth App at
# https://github.com/settings/developers (or your org's "OAuth Apps"
# page) and copy the client id + secret here.
#
# Authorization callback URL on the OAuth App must match
# GITHUB_OAUTH_REDIRECT_URL byte for byte.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback

# OAuth scopes requested at sign-in. `repo` covers private-repo PR
# visibility; `read:org` lets GitHub resolve `review-requested:@me`
# across orgs. Drop `repo` if you only care about public PRs.
OAUTH_SCOPES=repo,read:org

# --- Session cookie ---
# Secret used to sign the HttpOnly session cookie. Required.
# Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Rotating it logs everyone out, which is the desired property.
SESSION_SECRET=

# How long a signed session cookie stays valid (default 30 days).
SESSION_MAX_AGE_SECONDS=2592000

# Set to true behind HTTPS so the cookie is only sent over a secure
# connection. Leave false for local http://localhost dev.
COOKIE_SECURE=false

# --- Polling ---
# How often the per-user poller hits the GitHub GraphQL API, in
# seconds. At 300s (5 min) each connected user issues ~12 combined
# queries/hour. Each query can cost ~100-200 GraphQL points with our
# nested fragments, so this stays comfortably under their personal
# 5,000 points/hour primary limit. Lower with care.
POLL_INTERVAL_SECONDS=300

# Comma-separated list of bot logins. Comments / review threads opened
# by these accounts count toward the "B" chip; everyone else is a human.
BOT_LOGINS=cursor,cursor[bot],coderabbitai,coderabbitai[bot]

# Marker prefix used to detect the deployment-status comment on a PR.
PREVIEW_COMMENT_PREFIX=Preview Environment URL:

# GraphQL endpoint. Override for GitHub Enterprise.
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# REST API root. Override for GitHub Enterprise.
GITHUB_API_URL=https://api.github.com

# Maximum number of open PRs fetched per poll.
MAX_PRS=50

# --- Preference sync ---
# SQLite database that stores each viewer's synced preferences (the
# settings that used to live only in the browser's localStorage: watched
# / reviewed PRs, selected repos, tracked reviewer, theme, cloud-agent
# links). Resolved relative to the backend working directory. Point this
# at a mounted volume so preferences survive container restarts. Use
# ':memory:' for an ephemeral store.
PREFS_DB_PATH=data/better-gh.sqlite3

# GitHub login to track on each PR card as the "review requested from"
# reviewer. The card shows a blue R chip when this user is on the PR's
# requested-reviewers list, otherwise a one-click "request review" button.
# Set to an empty string to disable the feature.
REVIEWER_LOGIN=nicoraga1

# Merge method used by the per-card MERGE button when REVIEWER_LOGIN
# has approved the PR. One of: merge, squash, rebase.
MERGE_METHOD=merge

# Prefix used to match Linear ticket references inside PR titles/bodies.
# Anything of the form `<PREFIX><3+ digits>` (e.g. `ENG-1234`) wins a
# per-card "Linear" button that opens the matching ticket. Leave empty
# to disable the feature.
LINEAR_TICKET_PREFIX=ENG-

# Base URL of your Linear workspace. The Linear button links to
# `{LINEAR_WORKSPACE_URL}/issue/{TICKET}`, e.g.
# https://linear.app/clearest/issue/ENG-1234.
LINEAR_WORKSPACE_URL=https://linear.app/clearest

# Linear personal API key (Settings -> Security & access -> Personal API
# keys; starts with `lin_api_`). When set, the merge dialog offers a
# "merge & mark Linear ticket done" option that moves the PR's linked
# issue into its team's completed workflow state. Leave empty to disable.
LINEAR_API_KEY=

# --- Cursor Cloud Agents ---
# Cursor Cloud Agents API key (Cursor Dashboard -> Integrations / API
# Keys). When set, each PR card gets a "QA agent" control: paste a cloud
# agent link (e.g. https://cursor.com/agents/bc-...) and the card shows a
# live running/done badge plus a link to the run. Shared across the
# deploy; leave empty to disable the feature.
CURSOR_API_KEY=

# Base URL for the Cursor Cloud Agents API. Rarely needs changing.
CURSOR_API_URL=https://api.cursor.com
